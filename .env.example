# Public — inlined into the static build at build time, safe to expose (no secrets here).
# Base URL of the reviewguide-app deployment; CTA buttons link to `${NEXT_PUBLIC_APP_URL}/signup`.
NEXT_PUBLIC_APP_URL=https://app.reviewguide.eu

# GA4 measurement ID — leave empty to keep analytics fully inactive regardless of consent
# (ticket 6.6, part D). Set once GA4 is actually wanted; no code changes needed.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# English landing page (/en) — set to "true" only after the PM approves the EN hero/pricing/FAQ
# copy pasted in the ticket 6.6 delivery report (part E). Until then /en 404s and the nav's PL→EN
# switch stays hidden. See lib/en-landing.ts.
NEXT_PUBLIC_EN_LANDING_ENABLED=false
